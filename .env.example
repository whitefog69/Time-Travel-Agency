# ---------------------------------------------------------------------------
# TimeTravel Agency — environment variables
#
# Copy this file to `.env.local` and fill in your key:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# REQUIRED for the concierge chat widget.
# Get a key at https://console.mistral.ai/api-keys
# Without it the site still builds and runs — the chat widget simply replies
# with a polite "not configured yet" notice instead of live answers.
MISTRAL_API_KEY=

# OPTIONAL — override the Mistral model. Defaults to `mistral-small-latest`.
# MISTRAL_MODEL=mistral-small-latest

# OPTIONAL — select the chat provider. Defaults to `mistral`.
# Register additional providers in `src/lib/ai/provider.ts`.
# CHAT_PROVIDER=mistral

# OPTIONAL — extra origins allowed to call /api/chat cross-origin, comma
# separated. https://whitefog69.github.io is always allowed. Only needed when
# serving the frontend from a host that differs from the API.
# ALLOWED_ORIGINS=http://localhost:3001

# OPTIONAL — absolute URL of the chat API, for builds whose frontend is hosted
# apart from the backend (the GitHub Pages deploy). Unset, the widget calls its
# own /api/chat. NEXT_PUBLIC_* is inlined into the client bundle, so this is
# public by design — never put the API key here.
# NEXT_PUBLIC_CHAT_API_URL=https://your-app.vercel.app/api/chat
